# Shell (host) — build/runtime configuration.
#
# Copy this template to a per-environment file (gitignored) and fill in real values:
#   cp .env.example .env.prod    # used by `npm run build:prod` (minified)
#   cp .env.example .env.dev     # used by `npm run build:dev`  (readable, source maps)
# The build picks the file via APP_ENV; plain `npm run build` / `npm run dev`
# (no APP_ENV) fall back to .env.production / .env.development. `npm run dev`
# also works with NO .env file — the values below are the built-in fallbacks.
#
# Precedence (first wins; a real shell env var beats the files):
#   .env.<sel>.local > .env.<sel> > .env.local > .env   (sel = APP_ENV, else the build mode)

# Where the shell's own assets are served from (webpack output.publicPath).
PUBLIC_PATH=http://localhost:3000/

# Module Federation remote entry URLs — point these at the deployed remotes.
REMOTE_PRODUCTS_URL=http://localhost:3001/remoteEntry.js
REMOTE_CATEGORIES_URL=http://localhost:3002/remoteEntry.js
REMOTE_PRODUCTPAGE_URL=http://localhost:3004/remoteEntry.js

# Dev server port (npm run dev only; ignored by production builds).
DEV_PORT=3000
